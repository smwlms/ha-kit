<% from '_doorbell.jinja' import recipients, admins with context %>
<% set parcel_service = 'parcel-service' in modules %>
<% set labels = {'always': t('option_always'), 'home': t('option_home'), 'away': t('option_away'), 'never': t('option_never')} %>
<% if parcel_service %>
<% set labels = dict(labels, parcel_day=t('option_parcel_day')) %>
<% endif %>
{#- Doorbell: who gets a notification (ha-kit module doorbell, see doorbell/LOGIC.md). Filled in from house.yaml by
    tools/fill.py and uploaded by doorbell/deploy.py to /config/custom_templates/doorbell.jinja: edit house.yaml or the
    kit and deploy again, do not edit this file in Home Assistant.

    candidates()            JSON list of the people who may get a doorbell or parcel notification (people with notify,
                            limited to doorbell.recipients): key, name, notify (service without "notify."), person,
                            phone (device_tracker object id or null), admin (true/false)
    targets(kind, pressed)  JSON list of the notify services (without "notify.") for one message. kind:
                              ring          the doorbell rings: choice in input_select.doorbell_<key>_ring
                              parcel        parcel notifications: choice in input_select.doorbell_<key>_parcel
                              parcel_alert  safety notifications of the garage: same choice, but when nobody is left
                                            the admins get them (an open garage never stays silent)
                            Choices: Always · Only when I'm home (person.<key> is home) · Only when I'm away · Only on
                            a parcel day (ring, with parcel-service: input_datetime.parcel_expected is today) · Never.
                            An unknown choice counts as Always. Nobody matches = everyone who is not on Never.
                            pressed: sourceDeviceID and sourceDeviceName of the phone that pressed a notification
                            button; the person whose key, name or phone is one of its words is always added.
    names(services)         the names of the candidates behind a list of notify services, comma-separated (logbook)
    Use: {% from 'doorbell.jinja' import targets %}{{ targets('ring') | from_json }} -#}

{% macro candidates() -%}
[
<% for p in recipients %>
  {"key": "<@ p.key @>", "name": <@ p.name | tojson @>, "notify": <@ p.notify | tojson @>,
   "person": <@ (p.get('person') or 'person.' ~ p.key) | tojson @>,
   "phone": <@ p.phone | tojson if p.get('phone') else 'null' @>, "admin": <@ 'true' if p in admins else 'false' @>}<% if not loop.last %>,<% endif %>

<% endfor %>
]
{%- endmacro %}

{% macro targets(kind, pressed='') -%}
{%- set labels = <@ labels | tojson @> -%}
{%- set parcel_day = <@ "states('input_datetime.parcel_expected') == now().date() | string" if parcel_service else 'false' @> -%}
{%- set helper = 'ring' if kind == 'ring' else 'parcel' -%}
{#- Whole words only, so the key 'an' does not match "iPhone van Lien". -#}
{%- set words = (pressed or '') | string | lower | regex_findall('\\w+') -%}
{%- set ns = namespace(on=[], open=[], pressed=[]) -%}
{%- for p in candidates() | from_json -%}
  {%- set c = states('input_select.doorbell_' ~ p.key ~ '_' ~ helper) -%}
  {#- unknown, unavailable, or a label of another language or kit version: Always -#}
  {%- set c = c if c in labels.values() | list else labels.always -%}
  {%- set home = is_state(p.person, 'home') -%}
  {%- if c != labels.never -%}
    {%- set ns.open = ns.open + [p.notify] -%}
  {%- endif -%}
  {%- if c == labels.always or (c == labels.home and home) or (c == labels.away and not home)
        or (c == labels.get('parcel_day') and parcel_day) -%}
    {%- set ns.on = ns.on + [p.notify] -%}
  {%- endif -%}
  {%- if ([p.key, p.name | lower] + ([p.phone] if p.phone else [])) | select('in', words) | list -%}
    {%- set ns.pressed = ns.pressed + [p.notify] -%}
  {%- endif -%}
{%- endfor -%}
{#- Failsafe: nobody matches their choice -> everyone who is not on Never. -#}
{%- set out = ns.on or ns.open -%}
{%- if kind == 'parcel_alert' and not out -%}
  {%- set out = candidates() | from_json | selectattr('admin') | map(attribute='notify') | list -%}
{%- endif -%}
{{ (out + ns.pressed) | unique | list | to_json }}
{%- endmacro %}

{% macro names(services) -%}
{{ candidates() | from_json | selectattr('notify', 'in', services) | map(attribute='name') | join(', ') }}
{%- endmacro %}
