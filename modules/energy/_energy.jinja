  'waiting_sun_info', 'water_c', 'water_temperature', 'word_no', 'word_off', 'word_yes'] %>
<% set strings = {} %>
<% for k in screen_keys %><% set _ = strings.update({k: t(k)}) %><% endfor %>
<% set card = {'type': 'custom:energy-screen-card', 'features': has, 'roles': roles, 'battery_sign': battery_sign,
   'grid_import_kwh': imp_kwh, 'grid_export_kwh': exp_kwh, 'phases': phases,
   'consumers': consumer_list | selectattr('power') | list, 'savings': savings, 'settings': settings, 'cars': car_rows,
   'paths': paths, 'flow': flow, 'strings': strings} %>
<# --- the energy-analysis dashboard: data generators (window.haKitEnergyConfig) and the builder (dashboard/build.py) --- #>
<% set charger_ids = {'charger_w': 'sensor.ev_charger_power', 'charger_kwh': 'sensor.ev_charger_energy_today'} if has.charger else {} %>
<% set ids = {'imp_w': E.grid_import_w, 'exp_w': E.grid_export_w, 'imp_kwh': imp_kwh, 'exp_kwh': exp_kwh,
   'phases': [],
   'solar_w': E.get('solar_power_w') or none, 'solar_kwh': E.get('solar_energy_kwh') or none,
   'soc': E.get('battery_soc') or none, 'bat_w': (E.get('battery_power_w') or none) if has.battery else none,
   'chg_kwh': (E.get('battery_charge_kwh') or none) if has.battery else none, 'dis_kwh': (E.get('battery_discharge_kwh') or none) if has.battery else none,
   'charger_w': charger_ids.get('charger_w'), 'charger_kwh': charger_ids.get('charger_kwh'),
   'vent_w': vent_w, 'hp_w': 'sensor.heat_pump_power_estimated' if has.heat_pump else none,
   'hp_kwh': E.get('heat_pump_energy_kwh') or none, 'hp_state': 'sensor.heat_pump_state' if has.heat_pump else none,
   'spot': E.get('spot_price') if has.tariff else none, 'month_peak': month_peak, 'quarter': quarter} %>
<% set phase_ids = [] %>
<% for ph in phases %><% set _ = phase_ids.append({'imp': ph['import'], 'exp': ph['export']}) %><% endfor %>
<% set _ = ids.update({'phases': phase_ids}) %>
<% set cmp = T.get('compare') or {} %>
<% set analysis = {'analysis_from': (EN.get('analysis_from') or '') | string, 'battery_sign': battery_sign, 'locale': t('locale'),
   'ids': ids, 'consumers': consumer_list, 'battery_phase': EN.get('battery_phase') or none,
   'peak_target_kw': EN.get('peak_target_kw') or 3, 'capacity_minimum_kw': ((T.get('capacity') or {}).get('minimum_kw') or 0) if has.tariff else 0,
   'compare': ({'variable': cmp.get('variable'), 'fixed': cmp.get('fixed'), 'export': cmp.get('export') or 0,
                'fee_eur_per_year': cmp.get('fee_eur_per_year')} if has.compare else none),
   'fee_eur_per_year': T.get('fixed_eur_per_year') or 0,
   'nordpool': {'area': T.get('area') or 'BE', 'currency': 'EUR'},
   'away_below_kwh': EN.get('away_below_kwh') or 0,
   'battery': {'module_kwh': EN.get('battery_module_kwh') or 0, 'efficiency': EN.get('battery_efficiency') or 0.9,
               'reserve_percent': EN.get('battery_reserve_percent') or 20, 'full_percent': 95, 'investment_eur': EN.get('battery_investment_eur') or 0},
   'helpers': {'profiles_period': 'input_select.energy_profiles_period'},
   'strings': {'peak_source_meter': t('an_peak_source_meter'), 'peak_source_hourly': t('an_peak_source_hourly'),
               'peak_source_none': t('an_peak_source_none'), 'peak_cut': t('an_peak_cut'), 'peak_register_hour': t('an_peak_register_hour')}} %>
<# --- energy flows (www/energy-flows.js): energy meters ('change') or power roles ('mean') per quantity --- #>
<% set fl_energy = {'imp': imp_kwh, 'exp': exp_kwh} %>
<% set fl_power = {} %>
<% if E.get('solar_energy_kwh') %><% set _ = fl_energy.update({'pv': [E.solar_energy_kwh]}) %>
<% elif has.solar %><% set _ = fl_power.update({'pv': {'id': E.solar_power_w, 'sign': 1}}) %><% endif %>
<% if has.battery and E.get('battery_charge_kwh') and E.get('battery_discharge_kwh') %>
<% set _ = fl_energy.update({'chg': [E.battery_charge_kwh], 'dis': [E.battery_discharge_kwh]}) %>
<% elif has.battery and has.battery_power %>
<% set _ = fl_power.update({'bat': {'id': E.battery_power_w, 'sign': -1 if battery_sign == 'charge_positive' else 1}}) %>
<% endif %>
<% if has.charger %><% set _ = fl_energy.update({'ev': ['sensor.ev_charger_energy_today']}) %><% endif %>
<% set flat = [] %>
<% for v in fl_energy.values() %><% set _ = flat.extend(v) %><% endfor %>
<% set flows_cfg = {'date': 'input_datetime.energy_flows_date', 'energy': fl_energy, 'power': fl_power, 'energy_ids': flat,
   'power_ids': fl_power.values() | map(attribute='id') | list} %>
