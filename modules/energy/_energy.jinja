  'solar_tomorrow_info', 'solar_tomorrow_title', 'solar_word', 'source_forecast', 'source_history', 'stale',
  'stale_title', 'status_car_full', 'status_grid_assist', 'status_manual', 'status_no_car', 'status_off',
  'status_paused_battery', 'status_peak_limited', 'status_plan', 'status_solar', 'stopped', 'stopped_info',
  'sun_gone', 'sun_gone_info', 'sun_gone_short', 'sun_leaves', 'sunset_at', 'tap_row_hint', 'the_car',
  'three_phases', 'title', 'to_battery', 'to_car', 'to_grid', 'to_grid_dots', 'to_grid_info', 'to_grid_kw',
