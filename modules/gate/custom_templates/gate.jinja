<% if not cars %><@ fail('house.yaml has no cars (the module gate needs at least one)') @><% endif %>
<% if not people %><@ fail('house.yaml has no people (the module gate needs at least one)') @><% endif %>
{#- Gate: automatic opening (ha-kit module gate, see gate/LOGIC.md). Filled in from house.yaml by tools/fill.py:
    edit house.yaml or the kit and deploy again, do not edit this file in Home Assistant.

    cars()                 JSON list of the cars: prefix p, name, driver and the entity_id per role
    people()               JSON list of the people: key, name, person, phone (device_tracker), notify (service or
                           null), location_permission (sensor or null), admin (true/false)
    conditions(p)          conditions A and C of one car (p = prefix), as JSON
                             A  away_ok         = the car was further than gate_far_distance from home for at least
                                                  gate_away_minutes (sensor.gate_<p>_far_since) and is not home
                             C  navigating_home = navigation active, destination named like home
                                                  (house.home_destinations or house.address_regex) and its
                                                  coordinates within tolerance of zone.home
    all_conditions()       conditions(p) for every car, as JSON list in the order of cars()
    riders(p)              who is in car p, as JSON list of names
    recipients(user_id)    notify services for a message: the person of that HA user, else everyone with a phone
    Use: {% from 'gate.jinja' import conditions %}{{ conditions('<@ cars[0].prefix @>') | from_json }} -#}

{% macro cars() -%}
[
<% for a in cars %>
  {"p": "<@ a.prefix @>", "name": <@ a.name | tojson @>, "driver": <@ (a.get('driver') or '') | tojson @>,
   "loc": "<@ car_entity(a, 'location') @>", "route": "<@ car_entity(a, 'route') @>",
   "destination": "<@ car_entity(a, 'destination') @>", "distance": "<@ car_entity(a, 'distance_to_arrival') @>",
   "shift": "<@ car_entity(a, 'shift_state') @>", "speed": "<@ car_entity(a, 'speed') @>",
   "status": "<@ car_entity(a, 'status') @>", "located_at_home": "<@ car_entity(a, 'located_at_home') @>",
   "charging_state": "<@ car_entity(a, 'charging_state') @>", "charge_switch": "<@ car_entity(a, 'charge_switch') @>",
   "charge_cable": "<@ car_entity(a, 'charge_cable') @>", "charge_cable_lock": "<@ car_entity(a, 'charge_cable_lock') @>"}<% if not loop.last %>,<% endif %>

<% endfor %>
]
{%- endmacro %}

{% macro people() -%}
[
<% set admins = people | selectattr('admin', 'defined') | selectattr('admin') | list %>
<% for x in people %>
  {"key": "<@ x.key @>", "name": <@ x.name | tojson @>, "person": "<@ x.get('person') or 'person.' ~ x.key @>",
   "phone": <@ ('device_tracker.' ~ x.phone) | tojson if x.get('phone') else 'null' @>,
   "notify": <@ ('notify.' ~ x.notify) | tojson if x.get('notify') else 'null' @>,
   "location_permission": <@ (x.get('location_permission') or 'sensor.' ~ x.phone ~ '_location_permission') | tojson if x.get('phone') else 'null' @>,
   "admin": <@ 'true' if (x in admins or (not admins and loop.first)) else 'false' @>}<% if not loop.last %>,<% endif %>

<% endfor %>
]
{%- endmacro %}

{% macro conditions(p) -%}
{%- set a = cars() | from_json | selectattr('p', 'eq', p) | first -%}
{%- set car = states[a.loc] -%}
{%- set route = states[a.route] -%}
{%- set tol_m = states('input_number.gate_nav_home_tolerance') | float(150) -%}
{%- set car_pos = car is not none and car.attributes.latitude is number and car.attributes.longitude is number -%}
{#- last_reported = last time Teslemetry sent a position, even an unchanged one. -#}
{%- set car_age = ((now() - car.last_reported).total_seconds() | round(0) | int) if car_pos else none -%}
{#- Navigation: distance_to_arrival only has a value while a route is active; the route tracker keeps the last
    destination after navigation ends, so it cannot be used on its own. A sleeping car cannot navigate: after an HA
    restart its old navigation values are restored as-is. -#}
{%- set nav_active = has_value(a.distance) and not is_state(a.status, 'off') -%}
{%- set route_pos = route is not none and route.attributes.latitude is number and route.attributes.longitude is number -%}
{%- set dest_home_m = ((distance(route.entity_id, 'zone.home') * 1000) | round(0) | int) if route_pos else none -%}
{#- Only an explicit home destination counts: a neighbour's address lies within the tolerance too. The favourite is
    called "Home" or "Thuis" depending on the car's language; an address starts with the street, and the number must
    end there (12 matches, 125 does not). -#}
{%- set dest_name = states(a.destination) -%}
{%- set dn = dest_name | lower | trim -%}
{%- set name_home = dn in <@ house.home_destinations | map('lower') | list | tojson @>
      or dn is search('(^|[^a-z])<@ house.address_regex | replace('\\', '\\\\') @>([^0-9a-z]|$)') -%}
{%- set nav_home = nav_active and name_home and dest_home_m is not none and dest_home_m <= tol_m -%}
{%- set far = states('sensor.gate_' ~ p ~ '_far_since') | as_datetime(none) -%}
{%- set need_min = states('input_number.gate_away_minutes') | float(5) -%}
{%- set away_min = ((now() - far).total_seconds() / 60) | round(1) if far is not none else none -%}
{%- set away_ok = away_min is not none and away_min >= need_min and car is not none and car.state != 'home' -%}
{%- set gate_m = ((distance(car.entity_id, 'zone.gate_approach') * 1000) | round(0) | int) if car_pos else none -%}
{{ {
  'car': p,
  'name': a.name,
  'navigating_home': nav_home,
  'away_ok': away_ok,
  'away_min': away_min,
  'need_min': need_min,
  'ready': away_ok and nav_home,
  'gate_distance_m': gate_m,
  'car_age_s': car_age,
  'nav_active': nav_active,
  'destination_name': dest_name if nav_active else none,
  'destination_name_home': name_home,
  'distance_to_arrival_km': states(a.distance),
  'destination_to_home_m': dest_home_m,
  'tolerance_m': tol_m | int
} | to_json }}
{%- endmacro %}

{% macro all_conditions() -%}
{%- set ns = namespace(l=[]) -%}
{%- for a in cars() | from_json -%}
  {%- set ns.l = ns.l + [conditions(a.p) | from_json] -%}
{%- endfor -%}
{{ ns.l | to_json }}
{%- endmacro %}

{#- riders(p): a phone counts when its position is at most 5 min old, it is not home (a phone at home is never in an
    arriving car, which passes close to the house) and it lies within 300 m of the car. No phone found: the car's usual
    driver (cars()[].driver), unless that person's phone reported in the last 20 min (then it shows them elsewhere). -#}
{% macro riders(p) -%}
{%- set a = cars() | from_json | selectattr('p', 'eq', p) | first | default(none) -%}
{%- set car = states[a.loc] if a else none -%}
{%- set ps = people() | from_json | selectattr('phone') | list -%}
{%- set ns = namespace(r=[]) -%}
{%- for x in ps -%}
  {%- set ph = states[x.phone] -%}
  {%- if car is not none and ph is not none and car.attributes.latitude is number and ph.attributes.latitude is number
        and ph.state != 'home' and (now() - ph.last_updated).total_seconds() < 300
        and distance(x.phone, car.entity_id) * 1000 < 300 -%}
    {%- set ns.r = ns.r + [x.name] -%}
  {%- endif -%}
{%- endfor -%}
{%- if not ns.r and a and a.driver -%}
  {%- set u = people() | from_json | selectattr('key', 'eq', a.driver) | first | default(none) -%}
  {%- set ph = states[u.phone] if u and u.phone else none -%}
  {%- if u and (ph is none or (now() - ph.last_updated).total_seconds() >= 1200) -%}
    {%- set ns.r = [u.name] -%}
  {%- endif -%}
{%- endif -%}
{{ ns.r | to_json }}
{%- endmacro %}

{#- recipients(user_id): the notify service of the person linked to that HA user (a script started from the phone
    or the dashboard), otherwise the services of everyone with a phone (started by an automation). -#}
{% macro recipients(user_id=none) -%}
{%- set ps = people() | from_json | selectattr('notify') | list -%}
{%- set mine = (states.person | selectattr('attributes.user_id', 'eq', user_id) | map(attribute='entity_id') | list)
      if user_id else [] -%}
{%- set own = ps | selectattr('person', 'in', mine) | list -%}
{{ (own or ps) | map(attribute='notify') | list | to_json }}
{%- endmacro %}
