<% from '_results.jinja' import has, exp with context %>
{#- Results: macros for the results sensors (ha-kit module results, see results/LOGIC.md).
    Filled in from house.yaml by tools/fill.py: edit house.yaml or the kit and deploy again, do not edit this file in
    Home Assistant.

    counter_step(old, old_day, new, daily)  kWh added to a counter since the reading `old` (taken on `old_day`,
        YYYY-MM-DD): new - old when it rose; a drop is a new day when daily is true and the day changed (the new
        value counts from 0), else a glitch or a replaced meter (0); a step above 50 kWh is a reconfigured sensor (0);
        0 when either reading is unknown.
    export_total()   kWh sent to the grid so far (sum of entities.grid_export_kwh), '' while one register has no value
    room_now()       'True' when the solar export could have gone somewhere now: <@ 'the tank (hot-water on, more than 3 °C under its surplus maximum)' if has.hot_water else '' @><@ ' or ' if has.hot_water and has.charger else '' @><@ 'a connected car that is not full and takes less than 1 kW' if has.charger else '' @>
    Use: {% from 'results.jinja' import counter_step %}{{ counter_step(3.0, '2026-10-05', 4.5, true) }} -> 1.5 -#}

{% macro counter_step(old, old_day, new, daily=false) -%}
{%- set o = old | float(none) -%}
{%- set n = new | float(none) -%}
{%- if o is none or n is none -%}0
{%- elif n >= o -%}{{ (n - o) | round(4) if n - o <= 50 else 0 }}
{%- elif daily and old_day != now().date().isoformat() -%}{{ n | round(4) if n <= 50 else 0 }}
{%- else -%}0
{%- endif -%}
{%- endmacro %}

{% macro export_total() -%}
{%- set vals = <@ exp | tojson @> | map('states') | map('float', none) | list -%}
{{ (vals | sum) | round(4) if vals | select('number') | list | count == vals | count else '' }}
{%- endmacro %}

{% macro room_now() -%}
<% if has.hot_water %>
{%- set tank = is_state('input_boolean.hot_water_on_surplus', 'on')
      and states('sensor.hot_water_temperature') | float(99) < states('input_number.hot_water_surplus_max') | float(65) - 3 -%}
<% else %>
{%- set tank = false -%}
<% endif %>
<% if has.charger %>
{%- set car = is_state('binary_sensor.ev_charger_connected', 'on')
      and not is_state('sensor.ev_charger_status', 'complete')
      and states('sensor.ev_charger_power') | float(0) < 1000<% if has.ev_charging %>

      and states('sensor.ev_charging_energy_needed') | float(1) > 0<% endif %> -%}
<% else %>
{%- set car = false -%}
<% endif %>
{{ tank or car }}
{%- endmacro %}
